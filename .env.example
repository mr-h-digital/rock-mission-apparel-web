# Base URL of the rock-mission-apparel-api deployment.
# Leave unset during early development - the storefront falls back to
# browsing/cart with checkout disabled until this is configured.
VITE_API_URL=https://api.shop.rockmission.co.za

# Optional: override auth endpoint paths if your Railway API uses different routes.
VITE_AUTH_REGISTER_PATH=/api/auth/register
VITE_AUTH_LOGIN_PATH=/api/auth/login
VITE_AUTH_ME_PATH=/api/auth/me
VITE_AUTH_FORGOT_PASSWORD_PATH=/api/auth/forgot-password
VITE_AUTH_RESET_PASSWORD_PATH=/api/auth/reset-password
VITE_AUTH_FORGOT_USERNAME_PATH=/api/auth/forgot-username
